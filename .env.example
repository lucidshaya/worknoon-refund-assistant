# Copy this file to .env in the project root before running docker-compose up.
#
# Get an Anthropic API key at https://console.anthropic.com/
# The app runs fully without a key -- it falls back to a deterministic
# keyword-based classifier and templated replies -- but the AI-generated
# classification/reasoning/replies described in the README only appear
# once a real key is set here.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for classification and reply
# drafting.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
